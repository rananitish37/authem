# Server Configuration
PORT=8081

# Database Credentials & Connection
DB_URL=jdbc:mysql://localhost:3306/authem_user_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# JPA Settings
JPA_DDL_AUTO=update
SHOW_SQL=true

# JWT Security Secrets
JWT_SECRET=your_256_bit_jwt_secret_key_here
JWT_EXPIRATION=86400000